pkgver() {
  cd dwmblocks
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd dwmblocks
  # programs started from block clicks must not inherit dwmblocks' blocked signals
  patch -Np1 -i "$srcdir/unblock-signals.patch"
  cp "$srcdir/config.h" config.h
}

build() {
  cd dwmblocks
  make
}

package() {
  cd dwmblocks
  make PREFIX=/usr DESTDIR="$pkgdir" install
  local s
  for s in "${_scripts[@]}"; do
    install -Dm755 "$srcdir/$s" "$pkgdir/usr/bin/$s"
  done
  install -Dm644 "$srcdir/sb-view-lib" "$pkgdir/usr/bin/sb-view-lib"   # sourced, not run
}
