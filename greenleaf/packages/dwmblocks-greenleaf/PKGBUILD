# Maintainer: Greenleaf
# The Greenleaf status bar: dwmblocks-async plus the sb-* block scripts and their popups.
# Blocks: CPU, GPU (NVIDIA only), memory, network down/up speed, volume, and the date and
# time (centred by dwm-greenleaf). Every block is clickable; CPU, GPU and memory open usage
# views, volume scrolls/mutes, network shows addresses, the clock shows a calendar.
# The scripts are the ones in ArchStuff/scripts/ (symlinked here).
pkgname=dwmblocks-greenleaf
pkgver=r74.469e684
pkgrel=2
_commit=469e6841432693d81a17088706d99ef044a29936
pkgdesc="Clickable dwm status bar, Greenleaf edition (dwmblocks-async)"
arch=('x86_64')
url="https://github.com/UtkarshVerma/dwmblocks-async"
license=('GPL-2.0-only')
depends=('libxcb' 'xcb-util' 'st-greenleaf' 'procps-ng' 'gawk' 'ncurses' 'iproute2'
         'util-linux' 'libpulse' 'alsa-utils')
optdepends=('nvidia-utils: GPU block and GPU usage view')
makedepends=('git')
provides=('dwmblocks')
conflicts=('dwmblocks')
_scripts=(sb-clock sb-cpu sb-cpu-view sb-gpu sb-gpu-view sb-memory sb-mem-view
          sb-network sb-popup sb-volume sb-livehint)
source=("dwmblocks::git+https://github.com/UtkarshVerma/dwmblocks-async#commit=${_commit}"
        'unblock-signals.patch'
        'config.h'
        sb-view-lib "${_scripts[@]}")
sha256sums=('addda50ae766c2e3514471012cdcd456239161cfb93444cba7c57a3e7249d6ce'
            '23c87c3e435ae423ffedfa99e3489e113fc6601390ee02a9d91e5915438ab3df'
