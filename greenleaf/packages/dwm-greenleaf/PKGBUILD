# Maintainer: Greenleaf
# dwm 6.8 + fibonacci layout + gaps (from ~/dwm) + systray, with the Greenleaf config.h.
# systray.patch is the official dwm-systray-6.8.diff, adapted to apply after greenleaf.patch.
# To change the config: edit config.h here, then run tools/build-repo.sh.
pkgname=dwm-greenleaf
pkgver=6.8
pkgrel=3
_commit=f63cde9354504ee9cfecc07517c03736d0f90c26
pkgdesc="Dynamic window manager for X, Greenleaf edition"
arch=('x86_64')
url="https://dwm.suckless.org"
license=('MIT')
depends=('libx11' 'libxinerama' 'libxft' 'freetype2' 'fontconfig')
makedepends=('git')
provides=('dwm')
conflicts=('dwm')
source=("dwm::git+https://git.suckless.org/dwm#commit=${_commit}"
        'greenleaf.patch'
        'systray.patch'
        'config.h')
sha256sums=('SKIP' 'fa1ea7cae640d8553604f9411aae5861aa99c857121228c5ea7765de907e8d58' 'a04636e7f5634c589f57d92dea00f2f071bf749f555d7c8405f63f933040e1ff' '1306d7b70b21f6e9881ec90e461b7519be797acaa447d4ea117572dc34d58ee6')

prepare() {
  cd dwm
  patch -Np1 -i "$srcdir/greenleaf.patch"
  patch -Np1 -i "$srcdir/systray.patch"
  cp "$srcdir/config.h" config.h
}

build() {
  cd dwm
  make X11INC=/usr/include/X11 X11LIB=/usr/lib/X11 FREETYPEINC=/usr/include/freetype2
}

package() {
  cd dwm
  make PREFIX=/usr DESTDIR="$pkgdir" install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
