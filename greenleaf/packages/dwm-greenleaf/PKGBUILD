# Maintainer: Greenleaf
# dwm 6.8 with the Greenleaf config.h. greenleaf.patch is generated from ~/dwm and carries:
# fibonacci layout + gaps, systray, statuscmd (clickable status sections for dwmblocks),
# and restartsig + preserveonrestart: Alt+Ctrl+Shift+Q (or kill -HUP) restarts dwm in
# place and windows keep their tags.
# To change the config: edit config.h here, then run tools/build-repo.sh.
pkgname=dwm-greenleaf
pkgver=6.8
pkgrel=8
_commit=f63cde9354504ee9cfecc07517c03736d0f90c26
pkgdesc="Dynamic window manager for X, Greenleaf edition"
arch=('x86_64')
url="https://dwm.suckless.org"
license=('MIT')
depends=('libx11' 'libxinerama' 'libxft' 'freetype2' 'fontconfig')
makedepends=('git')
provides=('dwm')
conflicts=('dwm')
source=("dwm::git+https://git.suckless.org/dwm#commit=${_commit}"
        'greenleaf.patch'
        'config.h')
sha256sums=('SKIP' '2654d7de4e6072a5f4889cb1e92d400bf0ff0bec3c68626e53a74bc73283f97f' '49183d7f9594b8532e8ce0a0833df09a8de3f2817ccc4a0dafce674a12fc1e40')

prepare() {
  cd dwm
  patch -Np1 -i "$srcdir/greenleaf.patch"
  cp "$srcdir/config.h" config.h
}

build() {
  cd dwm
  make X11INC=/usr/include/X11 X11LIB=/usr/lib/X11 FREETYPEINC=/usr/include/freetype2
}

package() {
  cd dwm
  make PREFIX=/usr DESTDIR="$pkgdir" install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
