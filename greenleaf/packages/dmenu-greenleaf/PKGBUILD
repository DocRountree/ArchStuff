# Maintainer: Greenleaf
# dmenu 5.4 + greenleaf.patch: centred over a blurred, darkened snapshot of the screen,
# large centred text entry with a horizontal result row beneath it (no box or border),
# fuzzy + keyword matching, and mouse support (hover, click, wheel).
# dmenu_run uses app mode (-a): desktop apps in the first row, terminal apps, developer tools
# and other commands in a dimmer second row, tag search via desktop entries and the tags
# file (installed to /etc/dmenu-greenleaf/tags), and launch history.
# dwm still passes its colours; fonts come from config.h (dwm's -fn is ignored).
# To change it: edit ~/dmenu on its greenleaf branch, then regenerate the patch with
#   git -C ~/dmenu diff master greenleaf > greenleaf.patch
# and update the checksum below.
pkgname=dmenu-greenleaf
pkgver=5.4
pkgrel=4
_commit=7175c4880bac3d2a2d4a6262b59193f0a38e2fdb
pkgdesc="Dynamic menu for X, Greenleaf edition"
arch=('x86_64')
url="https://tools.suckless.org/dmenu"
license=('MIT')
depends=('sh' 'libx11' 'libxinerama' 'libxft' 'freetype2' 'fontconfig')
makedepends=('git')
provides=('dmenu')
conflicts=('dmenu')
source=("dmenu::git+https://git.suckless.org/dmenu#commit=${_commit}"
        'greenleaf.patch'
        'tags')
backup=('etc/dmenu-greenleaf/tags')
sha256sums=('SKIP' '89489a9336acf66cf5f0a1c866bee8a8996e3bee7ecf5841d2029fa6eaa6bfdc' '3d87a1b25defa23cefdde2fe4b1853e0934f189e6435393096dd4607ec5003c3')

prepare() {
  cd dmenu
  patch -Np1 -i "$srcdir/greenleaf.patch"
}

build() {
  cd dmenu
  make X11INC=/usr/include/X11 X11LIB=/usr/lib/X11 FREETYPEINC=/usr/include/freetype2
}

package() {
  cd dmenu
  make PREFIX=/usr DESTDIR="$pkgdir" install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/tags" "$pkgdir/etc/dmenu-greenleaf/tags"
}
