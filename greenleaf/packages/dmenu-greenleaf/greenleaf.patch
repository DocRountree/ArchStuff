+static struct app *
+getapp(const char *cmd)
+{
+	size_t i;
+
+	for (i = 0; i < napps; i++)
+		if (!strcmp(apps[i].cmd, cmd))
+			return &apps[i];
+	if (!(apps = realloc(apps, (napps + 1) * sizeof *apps)))
+		die("realloc:");
+	apps[napps].cmd = estrdup(cmd);
+	apps[napps].tags = apps[napps].utags = NULL;
+	apps[napps].weight = 0;
+	return &apps[napps++];
+}
