+static void
+loaddesktop(const char *path)
+{
+	FILE *fp;
+	char *line = NULL, cmd[256] = "", flatpak[256] = "", *v, *tags = NULL;
+	size_t sz = 0, i, len;
+	ssize_t n;
+	int inentry = 0, hidden = 0, ok = 0, terminal = 0, dev = 0;
+	struct app *a;
+
+	if (!(fp = fopen(path, "r")))
+		return;
+	while ((n = getline(&line, &sz, fp)) != -1) {
+		while (n > 0 && (line[n - 1] == '\n' || line[n - 1] == '\r'))
+			line[--n] = '\0';
+		if (line[0] == '[') {
+			inentry = !strcmp(line, "[Desktop Entry]");
+			continue;
+		}
+		if (!inentry || !(v = strchr(line, '=')))
+			continue;
+		*v++ = '\0';
+		/* only untranslated keys; Name[de]= etc. are skipped */
+		if (!strcmp(line, "Exec"))
+			ok = execcmd(v, cmd, sizeof cmd);
+		else if (!strcmp(line, "X-Flatpak"))
+			snprintf(flatpak, sizeof flatpak, "%s", v);
+		else if ((!strcmp(line, "NoDisplay") || !strcmp(line, "Hidden")) && !strcmp(v, "true"))
+			hidden = 1;
+		else if (!strcmp(line, "Terminal") && !strcmp(v, "true"))
+			terminal = 1;
+		else if (!strcmp(line, "Name") || !strcmp(line, "GenericName") ||
+		         !strcmp(line, "Keywords"))
+			appendtags(&tags, v, 1);
+		else if (!strcmp(line, "Categories")) {
+			appendtags(&tags, v, 1);
