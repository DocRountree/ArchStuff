+/* the command a desktop entry's Exec= line runs, without path or arguments */
+static int
+execcmd(const char *exec, char *out, size_t outsz)
+{
+	const char *p = exec, *e, *b;
+	size_t n;
+
+	for (;;) {
+		while (*p == ' ' || *p == '\t')
+			p++;
+		if (*p == '"') {
+			e = strchr(++p, '"');
+			if (!e)
+				return 0;
+		} else
+			for (e = p; *e && *e != ' ' && *e != '\t'; e++)
+				;
+		if (e == p)
+			return 0;
+		/* skip "env" and VAR=value prefixes */
+		if ((e - p == 3 && !strncmp(p, "env", 3)) || memchr(p, '=', e - p)) {
+			p = *e ? e + 1 : e;
+			continue;
+		}
+		for (b = e; b > p && b[-1] != '/'; b--)
+			;
+		n = MIN((size_t)(e - b), outsz - 1);
+		memcpy(out, b, n);
+		out[n] = '\0';
+		return n > 0;
+	}
+}
