+static void
+loaddesktopdir(const char *dir)
+{
+	DIR *d;
+	struct dirent *de;
+	char path[4096];
+	size_t n;
+
+	if (!(d = opendir(dir)))
+		return;
+	while ((de = readdir(d))) {
+		n = strlen(de->d_name);
+		if (n < 9 || strcmp(de->d_name + n - 8, ".desktop"))
+			continue;
+		snprintf(path, sizeof path, "%s/%s", dir, de->d_name);
+		loaddesktop(path);
+	}
+	closedir(d);
+}
