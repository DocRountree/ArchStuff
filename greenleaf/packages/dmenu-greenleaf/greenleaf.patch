+static void
+histpath(char *buf, size_t n, int mkdirs)
+{
+	const char *c = getenv("XDG_CACHE_HOME"), *h = getenv("HOME");
+
+	if (c && *c)
+		snprintf(buf, n, "%s/dmenu-greenleaf", c);
+	else
+		snprintf(buf, n, "%s/.cache/dmenu-greenleaf", h ? h : ".");
+	if (mkdirs) {
+		char *sl = strrchr(buf, '/');
+
+		*sl = '\0';
+		mkdir(buf, 0755); /* the cache dir itself may not exist yet */
+		*sl = '/';
+		mkdir(buf, 0755);
+	}
+	strncat(buf, "/history", n - strlen(buf) - 1);
+}
+
+static void
+loadhistory(void)
+{
+	FILE *fp;
+	char path[4096], *line = NULL, *cmd;
+	size_t sz = 0;
+	int count;
+
+	histpath(path, sizeof path, 0);
+	if (!(fp = fopen(path, "r")))
+		return;
+	while (getline(&line, &sz, fp) != -1) {
+		count = strtol(line, &cmd, 10);
+		if (count <= 0 || *cmd != ' ')
+			continue;
+		cmd[strcspn(cmd, "\n")] = '\0';
+		if (!*++cmd)
+			continue;
+		if (!(hist = realloc(hist, (nhist + 1) * sizeof *hist)))
+			die("realloc:");
+		hist[nhist].cmd = estrdup(cmd);
+		hist[nhist++].count = count;
+	}
+	free(line);
+	fclose(fp);
+}
+
+/* count one more launch of cmd; failures are ignored, history is only a hint */
+static void
+recordlaunch(const char *cmd)
+{
+	FILE *fp;
+	char path[4096], tmp[4200];
+	size_t i;
+	int found = 0;
+
+	if (!appmode || !*cmd || strchr(cmd, '\n'))
+		return;
+	histpath(path, sizeof path, 1);
+	snprintf(tmp, sizeof tmp, "%s.%ld", path, (long)getpid());
+	if (!(fp = fopen(tmp, "w")))
+		return;
+	for (i = 0; i < nhist; i++) {
+		if (!strcmp(hist[i].cmd, cmd)) {
+			hist[i].count++;
+			found = 1;
+		}
+		fprintf(fp, "%d %s\n", hist[i].count, hist[i].cmd);
+	}
+	if (!found)
+		fprintf(fp, "1 %s\n", cmd);
+	if (fclose(fp) == 0)
+		rename(tmp, path);
+	else
+		unlink(tmp);
+}
