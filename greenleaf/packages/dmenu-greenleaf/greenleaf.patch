+/* separable box blur over an interleaved RGB buffer, with clamped edges */
+static void
+boxblur(unsigned int *buf, unsigned int *tmp, int w, int h, int r)
+{
+	int x, y, c, i, d = 2 * r + 1;
+	unsigned int acc;
+
+#define PX(b, xx, yy, cc) (b)[((yy) * w + (xx)) * 3 + (cc)]
+	for (y = 0; y < h; y++)
+		for (c = 0; c < 3; c++) {
+			for (acc = 0, i = -r; i <= r; i++)
+				acc += PX(buf, MAX(0, MIN(i, w - 1)), y, c);
+			for (x = 0; x < w; x++) {
+				PX(tmp, x, y, c) = acc / d;
+				acc += PX(buf, MIN(x + r + 1, w - 1), y, c);
+				acc -= PX(buf, MAX(x - r, 0), y, c);
+			}
+		}
+	for (x = 0; x < w; x++)
+		for (c = 0; c < 3; c++) {
+			for (acc = 0, i = -r; i <= r; i++)
+				acc += PX(tmp, x, MAX(0, MIN(i, h - 1)), c);
+			for (y = 0; y < h; y++) {
+				PX(buf, x, y, c) = acc / d;
+				acc += PX(tmp, x, MIN(y + r + 1, h - 1), c);
+				acc -= PX(tmp, x, MAX(y - r, 0), c);
+			}
+		}
+#undef PX
+}
