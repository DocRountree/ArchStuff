+/*
+ * score an item against the space-separated keywords: every keyword must
+ * appear (in any order) either as a substring or, failing that, as a fuzzy
+ * subsequence. substring hits always outrank fuzzy hits.
+ */
+static int
+scoreitem(struct item *item, char **tokv, int tokc)
+{
+	const char *p, *str = item->text;
+	size_t len = strlen(str);
+	int i, sc, best, total = 0;
+
+	for (i = 0; i < tokc; i++) {
+		best = -1;
+		if ((p = fstrstr(str, tokv[i]))) {
+			best = 1000 - MIN(p - str, 50);
+			if (p == str)
+				best += 400;
+			else if (isboundary(str, p))
+				best += 200;
+			if (strlen(tokv[i]) == len)
+				best += 600; /* the keyword is the whole item */
+		}
+		best = MAX(best, tagscore(item->tags, tokv[i]));
+		if ((sc = tagscore(item->utags, tokv[i])) >= 0)
+			best = MAX(best, sc + 2000);
+		if (best < 0 && (sc = fuzzyscore(str, tokv[i])) >= 0)
+			best = sc;
+		if (best < 0)
+			return -1;
+		total += best;
+	}
+	return total - (int)MIN(len, 100) / 4; /* prefer shorter items */
+}
