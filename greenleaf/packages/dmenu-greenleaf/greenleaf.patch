+/*
+ * fuzzy subsequence score of pattern pat (length n) in str starting at start:
+ * returns -1 if not every pattern character appears in order.
+ */
+static int
+fuzzyfrom(const char *str, const char *start, const char *pat, size_t n)
+{
+	const char *s = start, *last = NULL;
+	size_t i;
+	int score = 0;
+
+	for (i = 0; i < n; i++, s++) {
+		for (; *s && foldc(*s) != foldc(pat[i]); s++)
+			;
+		if (!*s)
+			return -1;
+		score += 16;
+		if (last && s == last + 1)
+			score += 24;                     /* consecutive characters */
+		else if (last)
+			score -= MIN(s - last - 1, 15);  /* gap penalty */
+		if (isboundary(str, s))
+			score += (s == str) ? 32 : 20;   /* start of item / start of a word */
+		last = s;
+	}
+	return score;
+}
+
+static int
+fuzzyscore(const char *str, const char *pat)
+{
+	size_t n = strlen(pat);
+	const char *s;
+	int best = -1, sc;
+
+	/* try every occurrence of the first pattern character as the anchor */
+	for (s = str; *s; s++) {
+		if (foldc(*s) != foldc(*pat))
+			continue;
+		if ((sc = fuzzyfrom(str, s, pat, n)) < 0)
+			break; /* later anchors cannot match either */
+		best = MAX(best, sc);
+	}
+	return best;
+}
