+static void
+appendtags(char **tags, const char *s, int camel)
+{
+	size_t old = *tags ? strlen(*tags) : 0, n = strlen(s);
+	char *t, *d;
+	const char *p;
+
+	/* room for the text, a camel-case split copy, separators and NUL */
+	if (!(t = realloc(*tags, old + 2 * (2 * n + 2) + 2)))
+		die("realloc:");
+	*tags = t;
+	d = t + old;
+	if (!old)
+		*d++ = ' ';
+	for (p = s; *p; p++)
+		*d++ = isalnum((unsigned char)*p) ? tolower((unsigned char)*p) : ' ';
+	*d++ = ' ';
+	if (camel) { /* "TextEditor" also yields "text editor" */
+		for (p = s; *p; p++) {
+			if (p > s && isupper((unsigned char)*p) && islower((unsigned char)p[-1]))
+				*d++ = ' ';
+			*d++ = isalnum((unsigned char)*p) ? tolower((unsigned char)*p) : ' ';
+		}
+		*d++ = ' ';
+	}
+	*d = '\0';
+}
