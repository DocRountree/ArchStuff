+/*
+ * snapshot the screen area behind the menu, then downscale, blur, darken and
+ * upscale it into bgpix, which becomes the window background. on any failure
+ * bgpix stays None and dmenu falls back to a plain centred panel.
+ */
+static void
+makebackdrop(int x, int y, int w, int h)
+{
+	XImage *img;
+	unsigned int *buf, *tmp, one = 1, r, g, b, n;
+	int f = MAX(blurscale, 1), sw, sh, sx, sy, ix, iy, i, fast, *x0, *wx;
+	unsigned long p;
+
+	if (blurradius <= 0 || w <= 0 || h <= 0)
+		return;
+	if (!(img = XGetImage(dpy, root, x, y, w, h, AllPlanes, ZPixmap)))
+		return;
+	if (img->bits_per_pixel != 32 || img->red_mask != 0xff0000 ||
+	    img->green_mask != 0xff00 || img->blue_mask != 0xff) {
+		XDestroyImage(img);
+		return;
+	}
+	fast = (img->byte_order == LSBFirst) == (*(unsigned char *)&one == 1);
+#define GETPX(xx, yy) (fast ? (unsigned long)((uint32_t *)(img->data + (yy) * img->bytes_per_line))[xx] : XGetPixel(img, xx, yy))
+
+	sw = (w + f - 1) / f;
+	sh = (h + f - 1) / f;
+	buf = ecalloc((size_t)sw * sh * 3, sizeof *buf);
+	tmp = ecalloc((size_t)sw * sh * 3, sizeof *tmp);
+	x0 = ecalloc(w, sizeof *x0);
+	wx = ecalloc(w, sizeof *wx);
+
+	/* downscale by averaging f x f blocks, applying the dim factor */
+	for (sy = 0; sy < sh; sy++)
+		for (sx = 0; sx < sw; sx++) {
+			r = g = b = n = 0;
+			for (iy = sy * f; iy < MIN(sy * f + f, h); iy++)
+				for (ix = sx * f; ix < MIN(sx * f + f, w); ix++, n++) {
+					p = GETPX(ix, iy);
+					r += (p >> 16) & 0xff;
+					g += (p >> 8) & 0xff;
+					b += p & 0xff;
+				}
+			i = (sy * sw + sx) * 3;
+			buf[i]     = r * blurdim / (100 * n);
+			buf[i + 1] = g * blurdim / (100 * n);
+			buf[i + 2] = b * blurdim / (100 * n);
+		}
+
+	/* three box passes approximate a gaussian */
+	for (i = 0; i < 3; i++)
+		boxblur(buf, tmp, sw, sh, blurradius);
+
+	/* bilinear upscale back into the image, 8-bit fixed point weights */
+	for (ix = 0; ix < w; ix++) {
+		int fx = ((2 * ix + 1) * 256) / (2 * f) - 128;
+		fx = MAX(fx, 0);
+		x0[ix] = MIN(fx >> 8, sw - 1);
+		wx[ix] = (x0[ix] + 1 < sw) ? (fx & 0xff) : 0;
+	}
+	for (iy = 0; iy < h; iy++) {
+		int fy = ((2 * iy + 1) * 256) / (2 * f) - 128, y0, y1, wy;
+		fy = MAX(fy, 0);
+		y0 = MIN(fy >> 8, sh - 1);
+		y1 = MIN(y0 + 1, sh - 1);
+		wy = (y1 != y0) ? (fy & 0xff) : 0;
+		for (ix = 0; ix < w; ix++) {
+			unsigned int c[3], k, *a = &buf[(y0 * sw + x0[ix]) * 3], *d = &buf[(y1 * sw + x0[ix]) * 3];
+			int bx = wx[ix] ? 3 : 0;
+			for (k = 0; k < 3; k++)
+				c[k] = ((a[k] * (256 - wx[ix]) + a[k + bx] * wx[ix]) * (256 - wy) +
+				        (d[k] * (256 - wx[ix]) + d[k + bx] * wx[ix]) * wy) >> 16;
+			p = (unsigned long)c[0] << 16 | c[1] << 8 | c[2];
+			if (fast)
+				((uint32_t *)(img->data + iy * img->bytes_per_line))[ix] = p;
+			else
+				XPutPixel(img, ix, iy, p);
+		}
+	}
+#undef GETPX
+
+	bgpix = XCreatePixmap(dpy, root, w, h, DefaultDepth(dpy, screen));
+	XPutImage(dpy, bgpix, DefaultGC(dpy, screen), img, 0, 0, 0, 0, w, h);
+	XDestroyImage(img);
+	free(buf);
+	free(tmp);
+	free(x0);
+	free(wx);
+}
