+/* best score of keyword tok against an item's tags; "notes" also tries "note" */
+static int
+tagscore(const char *tags, const char *tok)
+{
+	char v[3][64];
+	size_t vl[3], n = 0, i, wl, tl = strlen(tok);
+	const char *w;
+	int best = -1;
+
+	if (!tags || tl < 3 || tl >= sizeof v[0])
+		return -1;
+	for (i = 0; i <= tl; i++)
+		v[0][i] = tolower((unsigned char)tok[i]);
+	vl[n++] = tl;
+	if (tl > 4 && !strcmp(v[0] + tl - 3, "ies")) { /* stories -> story */
+		memcpy(v[n], v[0], tl - 3);
+		strcpy(v[n] + tl - 3, "y");
+		vl[n] = tl - 2;
+		n++;
+	} else if (tl > 3 && v[0][tl - 1] == 's') {    /* notes -> note */
+		memcpy(v[n], v[0], tl - 1);
+		v[n][tl - 1] = '\0';
+		vl[n++] = tl - 1;
+	}
+	if (tl > 5 && !strcmp(v[0] + tl - 3, "ing")) { /* writing -> writ(e) */
+		memcpy(v[n], v[0], tl - 3);
+		v[n][tl - 3] = '\0';
+		vl[n++] = tl - 3;
+	}
+	for (w = tags; *w; w += wl) {
+		while (*w == ' ')
+			w++;
+		for (wl = 0; w[wl] && w[wl] != ' '; wl++)
+			;
+		for (i = 0; i < n && wl; i++)
+			if (wl >= vl[i] && !strncmp(w, v[i], vl[i]))
+				best = MAX(best, wl == vl[i] ? 950 : 850);
+	}
+	return best;
+}
