+static inline int
+foldc(int c)
+{
+	return casesens ? c : tolower((unsigned char)c);
+}
+
+static int
+isboundary(const char *str, const char *p)
+{
+	return p == str || strchr(" -_./:", p[-1]) || (isupper((unsigned char)*p) && islower((unsigned char)p[-1]));
+}
+
+/*
+ * fuzzy subsequence score of pattern pat (length n) in str starting at start:
+ * returns -1 if not every pattern character appears in order.
+ */
+static int
+fuzzyfrom(const char *str, const char *start, const char *pat, size_t n)
+{
+	const char *s = start, *last = NULL;
+	size_t i;
+	int score = 0;
+
+	for (i = 0; i < n; i++, s++) {
+		for (; *s && foldc(*s) != foldc(pat[i]); s++)
+			;
+		if (!*s)
+			return -1;
+		score += 16;
+		if (last && s == last + 1)
+			score += 24;                     /* consecutive characters */
+		else if (last)
+			score -= MIN(s - last - 1, 15);  /* gap penalty */
+		if (isboundary(str, s))
+			score += (s == str) ? 32 : 20;   /* start of item / start of a word */
+		last = s;
+	}
+	return score;
+}
+
+static int
+fuzzyscore(const char *str, const char *pat)
+{
+	size_t n = strlen(pat);
+	const char *s;
+	int best = -1, sc;
+
+	/* try every occurrence of the first pattern character as the anchor */
+	for (s = str; *s; s++) {
+		if (foldc(*s) != foldc(*pat))
+			continue;
+		if ((sc = fuzzyfrom(str, s, pat, n)) < 0)
+			break; /* later anchors cannot match either */
+		best = MAX(best, sc);
+	}
+	return best;
+}
+
+/*
+ * score an item against the space-separated keywords: every keyword must
+ * appear (in any order) either as a substring or, failing that, as a fuzzy
+ * subsequence. substring hits always outrank fuzzy hits.
+ */
+static int
+scoreitem(const char *str, char **tokv, int tokc)
+{
+	const char *p;
+	size_t len = strlen(str);
+	int i, sc, total = 0;
+
+	for (i = 0; i < tokc; i++) {
+		if ((p = fstrstr(str, tokv[i]))) {
+			total += 1000 - MIN(p - str, 50);
+			if (p == str)
+				total += 400;
+			else if (isboundary(str, p))
+				total += 200;
+			if (strlen(tokv[i]) == len)
+				total += 600; /* the keyword is the whole item */
+		} else if ((sc = fuzzyscore(str, tokv[i])) >= 0)
+			total += sc;
+		else
+			return -1;
+	}
+	return total - (int)MIN(len, 100) / 4; /* prefer shorter items */
+}
+
+static int
+itemcmp(const void *a, const void *b)
+{
+	const struct item *ia = *(struct item *const *)a, *ib = *(struct item *const *)b;
+
+	if (ia->score != ib->score)
+		return ib->score - ia->score;
+	return (ia < ib) ? -1 : (ia > ib); /* keep input order for ties */
+}
