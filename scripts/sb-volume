#!/bin/sh
# Default output volume (PipeWire/PulseAudio via pactl).
# Left click: mute/unmute.  Scroll: +/- 5% (up to 100%).  Right click: alsamixer.
sink=@DEFAULT_SINK@
vol() { pactl get-sink-volume "$sink" | awk -F/ 'NR == 1 { gsub(/[ %]/, "", $2); print $2; exit }'; }

case $BLOCK_BUTTON in
	1) pactl set-sink-mute "$sink" toggle ;;
	3) sb-popup volume 100x24 alsamixer ;;
	4) v=$(vol); [ "$v" -ge 95 ] && pactl set-sink-volume "$sink" 100% || pactl set-sink-volume "$sink" +5% ;;
	5) pactl set-sink-volume "$sink" -5% ;;
esac

v=$(vol)
if pactl get-sink-mute "$sink" | grep -q 'yes'; then
	printf '%s muted\n' "󰖁"
else
	printf '%s %s%%\n' "󰕾" "${v:-?}"
fi
