#!/bin/bash
# sb-cpu-view: a compact, readable CPU usage view for the status bar popup.
# Overall usage, one bar per core, and the busiest programs as a share of the
# whole CPU (processes grouped by program name). Refreshes every 2 seconds;
# q or Esc closes.

ncores=$(nproc)
barw=24

# colour by load: green < 50%, yellow < 80%, red above
colour() { if [ "$1" -ge 80 ]; then printf '\033[31m'; elif [ "$1" -ge 50 ]; then printf '\033[33m'; else printf '\033[32m'; fi; }
bar() { # bar PERCENT WIDTH
	local p=${1:-0} w=$2 n full empty
	[ "$p" -gt 100 ] && p=100
	n=$(( (p * w + 50) / 100 ))
	printf -v full '%*s' "$n" ''
	printf -v empty '%*s' "$((w - n))" ''
	colour "$p"; printf '%s' "${full// /█}"
	printf '\033[90m%s\033[0m' "${empty// /█}"
}

# per-core and total busy/idle jiffies: "name busy total" lines
snapshot() {
	awk '/^cpu/ { idle = $5 + $6; total = 0; for (i = 2; i <= 9; i++) total += $i; print $1, total - idle, total }' /proc/stat
}

tput civis; trap 'tput cnorm' EXIT
clear
while :; do
	before=$(snapshot)
	# top samples for ~1s; its second iteration is the current usage per process
	procs=$(top -b -n 2 -d 1 -w 512 -o %CPU | awk '
		/^top -/ { n++ }
		n == 2 && /^ *PID/ { on = 1; next }
		on && NF >= 12 {
			name = $12; for (i = 13; i <= NF; i++) name = name " " $i
			# browser helper processes -> the browser
			if (name ~ /^(Isolated Web Co|Web Content|WebExtensions|RDD Process|Socket Process|Privileged Cont|Utility Process|GeckoMain)$/) name = "firefox"
			cpu[name] += $9; cnt[name]++
		}
		END { for (k in cpu) printf "%s\t%d\t%.1f\n", k, cnt[k], cpu[k] }')
	after=$(snapshot)
	load=$(cut -d' ' -f1 /proc/loadavg)

	# per-core usage over the same second
	mapfile -t usage < <(paste -d' ' <(echo "$before") <(echo "$after") |
		awk '{ dt = $6 - $3; db = $5 - $2; printf "%s %d\n", $1, (dt > 0 ? (100 * db + dt / 2) / dt : 0) }')

	tput cup 0 0
	total=${usage[0]#* }
	printf '\033[1m CPU\033[0m  ' ; bar "$total" $barw; printf ' %3d%%\033[K\n' "$total"
	printf '\033[90m      %d cores · load %s\033[0m\033[K\n\033[K\n' "$ncores" "$load"

	# cores, two per line
	for ((i = 1; i <= ncores; i += 2)); do
		for j in $i $((i + 1)); do
			[ "$j" -gt "$ncores" ] && continue
			p=${usage[$j]#* }
			printf ' core %-2d ' "$j"; bar "$p" 10; printf ' %3d%%   ' "$p"
		done
		printf '\033[K\n'
	done

	printf '\033[K\n\033[1m Busiest programs\033[0m \033[90m(share of all CPU)\033[0m\033[K\n'
	shown=0
	while IFS=$'\t' read -r name count cpu; do
		share=$(awk -v c="$cpu" -v n="$ncores" 'BEGIN { printf "%d", c / n + 0.5 }')
		[ "$share" -lt 1 ] && continue
		label=$name; [ "$count" -gt 1 ] && label="$name ×$count"
		printf ' %-22.22s ' "$label"; bar "$share" 16; printf ' %3d%%\033[K\n' "$share"
		shown=$((shown + 1))
		[ "$shown" -ge 8 ] && break
	done < <(echo "$procs" | sort -t$'\t' -k3,3 -rn)
	[ "$shown" -eq 0 ] && printf '\033[90m nothing busy right now\033[0m\033[K\n'
	for ((k = shown; k < 8; k++)); do printf '\033[K\n'; done

	printf '\033[K\n\033[90m q or Esc to close · refreshes every 2 s\033[0m\033[K'
	tput ed
	read -rsn1 -t 1 key && case $key in q|Q|$'\e') exit 0 ;; esac
done
