#!/bin/bash
# sb-cpu-view: CPU usage popup. Overall usage, one bar per core, and the
# busiest programs as a share of the whole CPU (processes grouped by program).
. sb-view-lib
ncores=$(nproc)

# per-core and total busy/total jiffies: "name busy total" lines
snapshot() {
	awk '/^cpu/ { idle = $5 + $6; total = 0; for (i = 2; i <= 9; i++) total += $i; print $1, total - idle, total }' /proc/stat
}

view_start
while :; do
	before=$(snapshot)
	# top samples for ~1s; its second iteration is the current usage per process
	procs=$(top -b -n 2 -d 1 -w 512 -o %CPU | awk "$AWK_FRIENDLY"'
		/^top -/ { n++ }
		n == 2 && /^ *PID/ { on = 1; next }
		on && NF >= 12 {
			name = $12; for (i = 13; i <= NF; i++) name = name " " $i
			name = friendly(name); cpu[name] += $9; cnt[name]++
		}
		END { for (k in cpu) printf "%s\t%d\t%.1f\n", k, cnt[k], cpu[k] }')
	after=$(snapshot)
	read -r load _ < /proc/loadavg
	mapfile -t usage < <(paste -d' ' <(echo "$before") <(echo "$after") |
		awk '{ dt = $6 - $3; db = $5 - $2; printf "%s %d\n", $1, (dt > 0 ? (100 * db + dt / 2) / dt : 0) }')

	tput cup 0 0
	total=${usage[0]#* }
	printf '\033[1m'; row "CPU" "$total" "$(printf '%3d%%' "$total")"; printf '\033[0m'
	printf '\033[90m %d cores · load %s\033[0m\033[K\n\033[K\n' "$ncores" "$load"

	for ((i = 1; i <= ncores; i += 2)); do   # two cores per line
		for j in $i $((i + 1)); do
			[ "$j" -gt "$ncores" ] && continue
			p=${usage[$j]#* }
			printf ' '; pad "core $j" 7; bar "$p" 12; printf ' %3d%%    ' "$p"
		done
		printf '\033[K\n'
	done

	printf '\033[K\n\033[1m Busiest programs\033[0m \033[90m(share of all CPU)\033[0m\033[K\n'
	shown=0
	while IFS=$'\t' read -r name count cpu; do
		share=$(awk -v c="$cpu" -v n="$ncores" 'BEGIN { printf "%d", c / n + 0.5 }')
		[ "$share" -lt 1 ] && continue
		label=$name; [ "$count" -gt 1 ] && label="$name ×$count"
		row "$label" "$share" "$(printf '%3d%%' "$share")"
		shown=$((shown + 1)); [ "$shown" -ge 8 ] && break
	done < <(echo "$procs" | sort -t$'\t' -k3,3 -rn)
	[ "$shown" -eq 0 ] && printf '\033[90m nothing busy right now\033[0m\033[K\n' && shown=1
	for ((k = shown; k < 8; k++)); do printf '\033[K\n'; done
	view_footer
	view_wait 1 || exit 0
done
