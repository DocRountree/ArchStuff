#!/bin/sh
# Download / upload speed on the default-route interface, since the last update.
# Left click: interfaces, addresses and routes.
case $BLOCK_BUTTON in
	1) sb-popup network 120x16 --hold sh -c 'ip -br -c address; echo; ip route' ;;
esac

dev=$(ip route show default 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit } }')
if [ -z "$dev" ]; then
	printf '%s %-13s\n' "󰖪" offline   # same width as the rates
	exit 0
fi

stats=/sys/class/net/$dev/statistics
read -r rx < "$stats/rx_bytes"
read -r tx < "$stats/tx_bytes"
now=$(date +%s%N)
state=${XDG_RUNTIME_DIR:-/tmp}/sb-network.$(id -u)

rxrate=0 txrate=0
if [ -r "$state" ]; then
	read -r pdev pnow prx ptx < "$state"
	if [ "$pdev" = "$dev" ]; then
		ms=$(( (now - pnow) / 1000000 ))
		if [ "$ms" -gt 0 ]; then
			rxrate=$(( (rx - prx) * 1000 / ms ))
			txrate=$(( (tx - ptx) * 1000 / ms ))
		fi
	fi
fi
echo "$dev $now $rx $tx" > "$state"

# bytes per second -> short human form: 512B, 34K, 1.2M, 12M, 1.1G
human() {
	awk -v b="$1" 'BEGIN {
		if (b < 0) b = 0
		split("B K M G", u, " "); i = 1
		while (b >= 1024 && i < 4) { b /= 1024; i++ }
		if (i > 2 && b < 10) printf "%.1f%s", b, u[i]; else printf "%d%s", b, u[i]
	}'
}
# rates padded to 5 columns (longest is "1023K") so the bar never shifts
printf '%s %5s %s %5s\n' "" "$(human "$rxrate")" "" "$(human "$txrate")"
